rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /players/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid;
    }

    match /invites/{id} {
      allow read: if signedIn() &&
        (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.fromUid == request.auth.uid;
      allow update: if signedIn() &&
        (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid);
    }

    match /lobbies/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.hostUid == request.auth.uid;
      allow update: if signedIn();
    }

    match /games/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.playerUids;
      allow create: if signedIn() && request.auth.uid in request.resource.data.playerUids;
      allow update: if signedIn() && request.auth.uid in resource.data.playerUids;
    }

    match /leaderboard/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }
  }
}
